# ==============================================================================
# SuperSync Server 生产环境配置模板
# 复制此文件为 .env 并填入安全随机密码与域名
# 命令: cp env.example .env
# ==============================================================================

# 基础端口与绑定
PORT=3000
NODE_ENV=production

# 外部访问域名（例如：sync.yourdomain.com 或带端口的域名）
DOMAIN=sync.yourdomain.com

# JWT 鉴权密钥（必须至少 32 个随机字符！可用 openssl rand -hex 32 生成）
JWT_SECRET=replace_with_a_super_secure_random_string_min_32_chars

# 数据库配置
POSTGRES_DB=supersync
POSTGRES_USER=supersync
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# 允许跨域的前端来源（重要：GitHub Pages 和本地调试必须在此列出）
# 示例: https://tokewer.github.io,http://localhost:4200
CORS_ORIGINS=https://tokewer.github.io,http://localhost:4200,http://127.0.0.1:4200

# 注册控制（设为 true 或提供邀请码，防止公开互联网滥用）
ALLOW_PUBLIC_REGISTRATION=false
INVITATION_CODE=your_custom_private_invite_code

# 日志级别 (error, warn, info, debug)
LOG_LEVEL=info

# 数据库备份保留天数
BACKUP_RETENTION_DAYS=14
